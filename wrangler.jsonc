{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ios9-gemini-chat",
	"main": "src/index.js",
	"compatibility_date": "2024-09-01",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ios9-gemini-chat-db",
			"database_id": "xxx-xxx-xxx"
		}
	]
}
